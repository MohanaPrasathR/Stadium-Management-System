# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Leave DB_HOST empty to run with the in-memory demo store
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=stadium_management
# Used only by `npm run setup-db` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
